# Copia este archivo como .env.local y llénalo. NUNCA subas .env.local a GitHub.
# Los mismos valores van en Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (sin diagonal al final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notificaciones push. Genéralas con: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nietzschestudiosss@gmail.com

# Secreto para los crons (Vercel o pg_cron). Cualquier texto largo y aleatorio.
CRON_SECRET=
